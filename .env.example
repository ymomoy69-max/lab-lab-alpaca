# Optional local overrides. On Railway / shared deploys, leave these EMPTY —
# users paste their own paper keys in the dashboard setup form instead.
# Keys from the form live only in server memory (not written to disk / git).

# Alpaca paper trading (optional if using the UI form)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_PAPER=true
NEXUS_EXPECTED_ACCOUNT=

# Optional: multi-agent debate LLM (falls back to rules if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Safety — set yes only when ready to place orders (also a checkbox in the UI form)
NEXUS_ARMED=no

# ── Apex intraday mode (0DTE, hours-scale) ───────────────────────────────────
# Same-day expiry; max hold in hours; flat before market close
NEXUS_APEX_MODE=yes
NEXUS_TICK_SECONDS=30
NEXUS_MIN_DTE=0
NEXUS_MAX_DTE=0
NEXUS_EXIT_DTE=0
NEXUS_APEX_HOLD_SEC=10800
NEXUS_APEX_GIVEUP_SEC=3600
NEXUS_SESSION_CLOSE_BUFFER_MIN=45
NEXUS_MAX_STRUCTURES=4
NEXUS_MAX_ENTRIES_PER_TICK=2
NEXUS_CIRCUIT_BREAKER_PCT=-2
NEXUS_MAX_SPREAD_FRAC=0.40
NEXUS_ORDER_TYPE=limit
# IV/RV thresholds (Underwriter)
NEXUS_APEX_IV_RV_SELL=1.15
NEXUS_APEX_IV_RV_BUY=0.95
NEXUS_APEX_SKEW_Z=0.8
# Risk caps
NEXUS_APEX_MAX_LOSS_PCT=2.0
NEXUS_APEX_AGG_RISK_PCT=8.0
NEXUS_APEX_DAILY_HALT_PCT=-2.0
NEXUS_APEX_DD_HALT_PCT=-5.0
NEXUS_APEX_MAX_DELTA=40
NEXUS_APEX_MAX_POSITIONS=4
# Income sleeve (Spread Sentinel + Contour)
NEXUS_APEX_CREDIT_OTM=0.015
NEXUS_APEX_CREDIT_WIDTH=2.0
NEXUS_APEX_SHORT_DELTA=0.21
NEXUS_APEX_MIN_CREDIT_WIDTH=0.15
NEXUS_APEX_CREDIT_TP=0.50
NEXUS_APEX_CREDIT_STOP=2.0
NEXUS_APEX_HEDGE_DD=2.0
NEXUS_APEX_SATELLITE_PCT=3.4
NEXUS_APEX_CONSERVATIVE_FILLS=yes
NEXUS_APEX_LLM_VETO_ONLY=yes
# Disable scalp mode when apex is on
NEXUS_SCALP_MODE=no

# Hackathon window (optional — agent runs indefinitely by default)
# NEXUS_CONTEST_CLOSE=2026-09-04       # reference date only
# NEXUS_CONTEST_ENFORCE=no             # yes = stop trading after contest_close
# NEXUS_CONTEST_EXPIRY_EXIT=no         # yes = force-flat + pick expiries before contest end

# Agent tuning
# Sector mix (indices + GICS ETFs + non-tech leaders). Dynamic scan adds more names.
NEXUS_WATCHLIST=SPY,QQQ,IWM,DIA,XLK,XLF,XLE,XLV,XLY,XLP,XLI,XLB,XLU,XLC,XLRE,SMH,XBI,AAPL,NVDA,MSFT,JPM,XOM,UNH,WMT,CAT,BA,DIS,KO,GE,AMD
# Auto-add names that appear in news AND have liquid volume
NEXUS_DYNAMIC_WATCHLIST=true
NEXUS_MAX_DYNAMIC_SYMBOLS=12
NEXUS_MIN_SHARE_VOLUME=1000000
NEXUS_MIN_RELATIVE_VOLUME=1.0
NEXUS_MIN_DYNAMIC_PRICE=8
NEXUS_NEWS_SCAN_LIMIT=40
NEXUS_MOST_ACTIVE_TOP=35
NEXUS_DYNAMIC_TTL_TICKS=6
# Long consolidation → breakout scanner (adds names + biases BUY/SELL)
NEXUS_BREAKOUT_SCAN=true
NEXUS_BREAKOUT_CONS_BARS=60
NEXUS_BREAKOUT_MAX_RANGE_PCT=0.15
NEXUS_MAX_BREAKOUT_SYMBOLS=6
NEXUS_PATTERN_SCAN=true
NEXUS_MAX_PATTERN_SYMBOLS=6
# PCR ≤ 0.5 = resistance (call-heavy); PCR ≥ 1.5 = support (put-heavy)
NEXUS_PCR_RESISTANCE=0.5
NEXUS_PCR_SUPPORT=1.5
# Require EMA/MACD/RSI/stoch/BB/Elliott agreement before directional trades
NEXUS_MIN_INDICATOR_VOTES=2
NEXUS_INDICATOR_CONFIRM=true
# 5–10 minute scalps on 1-min tape; size from remaining risk budget (VaR/backtest scale qty, not veto).
NEXUS_SCALP_MODE=yes
NEXUS_TICK_SECONDS=30
NEXUS_SCALP_HOLD_SEC=600
NEXUS_SCALP_GIVEUP_SEC=300
NEXUS_SCALP_BAR_TIMEFRAME=1Min
NEXUS_SCALP_BARS=90
NEXUS_SCALP_SCAN_LIMIT=12
NEXUS_VAR_HORIZON_MIN=10
NEXUS_SIZE_FROM_RISK=yes
NEXUS_MIN_CONFIDENCE=52
NEXUS_MAX_PREMIUM_PCT=35
NEXUS_MAX_TOTAL_PREMIUM_PCT=90
NEXUS_MAX_STRUCTURES=10
NEXUS_MAX_VAR_PCT=40
NEXUS_CIRCUIT_BREAKER_PCT=-30
NEXUS_MIN_BACKTEST_WIN_RATE=0.32
NEXUS_HISTORY_BARS=200
NEXUS_HOURLY_BARS=500
NEXUS_MIN_DTE=0
NEXUS_MAX_DTE=10
NEXUS_ANALYZE_WHEN_CLOSED=true
NEXUS_FILL_TIMEOUT_SEC=20
NEXUS_SESSION_OPEN_BUFFER_MIN=2
NEXUS_SESSION_CLOSE_BUFFER_MIN=12
# Scalp 3:1: stop 5% of premium → take profit 15%. Time-stop at 10m (give-up at 5m if red).
NEXUS_TAKE_PROFIT_PCT=0.15
NEXUS_STOP_LOSS_PCT=-0.05
NEXUS_REWARD_RISK_RATIO=3
NEXUS_ORDER_TYPE=market
NEXUS_EXIT_DTE=0
NEXUS_CALIBRATION_PATH=data/calibration.json
